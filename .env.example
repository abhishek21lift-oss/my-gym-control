# =============================================================================
# MY GYM CONTROL — environment contract
#
# Copy to `.env` and fill in. Every variable here is validated by a Zod schema at
# process start (packages/contracts/src/env.ts). A missing or malformed value fails
# the boot immediately with a readable error, rather than surfacing as an undefined
# at 3am on the first request that happens to need it.
#
# Defaults below match docker-compose.yml, so `pnpm infra:up && pnpm dev` works with
# a straight copy of this file and no external accounts.
# =============================================================================

NODE_ENV=development

# --- API -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Database --------------------------------------------------------------
# Local Docker Postgres. Swap for the Supabase pooled connection string in
# staging/production (port 6543, pgbouncer=true).
DATABASE_URL=postgresql://mgc:mgc_local_dev@localhost:5432/my_gym_control?schema=public
# Direct (unpooled) connection — Prisma Migrate cannot run through pgbouncer.
DIRECT_URL=postgresql://mgc:mgc_local_dev@localhost:5432/my_gym_control?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# 32+ byte random string. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# WebAuthn / passkeys. RP_ID must be the bare domain (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MY GYM CONTROL
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Supabase (Phase 1 — leave blank until provisioned) --------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=

# --- Storage (S3-compatible: MinIO locally, Cloudflare R2 in production) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=mgc_local
STORAGE_SECRET_ACCESS_KEY=mgc_local_dev_secret
STORAGE_BUCKET_MEDIA=mgc-media
# Body/progress imagery is separated from general media so retention and access
# policy can differ. See docs/ARCHITECTURE.md §10.
STORAGE_BUCKET_BODY=mgc-body-private
STORAGE_FORCE_PATH_STYLE=true

# --- Payments (Razorpay) ---------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI providers (Phase 5 — at least one required once AI is enabled) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Web apps --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
