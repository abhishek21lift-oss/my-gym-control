{
  "name": "@mgc/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, and the tenancy/audit client extensions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "clean": "rimraf dist src/generated .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@mgc/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "catalog:",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "prisma": "catalog:",
    "rimraf": "6.1.3",
    "tsx": "4.20.6",
    "typescript": "catalog:"
  }
}
